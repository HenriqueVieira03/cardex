<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!--
    O app MAUI compila para Android/iOS/Windows e não pode ser referenciado por um
    projeto de teste comum. Por isso incluímos (por link) só os arquivos que não
    dependem de UI: Models e Data. Eles são os mesmos arquivos do app, não cópias.
  -->
  <ItemGroup>
    <Compile Include="..\Cardex\Models\*.cs" Link="App\Models\%(Filename)%(Extension)" />
    <Compile Include="..\Cardex\Data\*.cs" Link="App\Data\%(Filename)%(Extension)" />
    <Compile Include="..\Cardex\Services\ProgressoService.cs" Link="App\Services\ProgressoService.cs" />
    <None Include="..\Cardex\Resources\Raw\me05.json" Link="App\me05.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
