<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cardex.ViewModels"
             x:Class="Cardex.Views.StatusPage"
             x:DataType="vm:StatusViewModel"
             Title="Cardex">

    <!-- Tela provisória da etapa 1 (status do banco). -->
    <VerticalStackLayout Padding="24" Spacing="16">
        <Label Text="Cardex" FontSize="32" FontAttributes="Bold" />
        <Label Text="Etapa 1 · banco de dados e catálogo" />

        <ActivityIndicator IsRunning="{Binding Carregando}" IsVisible="{Binding Carregando}" />

        <Label Text="{Binding Mensagem}" />
        <Label Text="{Binding Resumo}" FontSize="16" />

        <Button Text="Recarregar" Command="{Binding CarregarCommand}" />
    </VerticalStackLayout>
</ContentPage>
